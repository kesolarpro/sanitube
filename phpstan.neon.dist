includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - src
        - config
        - routes
        - tests

    # Raised to 6 with the domain model: from here on, every method that
    # returns or accepts a collection has to say what is in it. On a catalogue
    # this is the difference between "a list" and "a list of tracks", and it is
    # the annotation that stops a Release quietly holding Assets.
    level: 6

    checkModelProperties: true

    # No ignored errors. An ignore added speculatively — for a problem that was
    # anticipated rather than observed — is itself reported as an unmatched
    # pattern, and rightly so.
