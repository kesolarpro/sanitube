includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - src
        - config
        - routes
        - tests

    # Level 5 is the honest starting point for a codebase this young: it
    # catches real mistakes without demanding annotations on scaffolding that
    # has not been written yet. Raised as the domain model lands.
    level: 5

    checkModelProperties: true

    # No ignored errors. An ignore added speculatively — for a problem that was
    # anticipated rather than observed — is itself reported as an unmatched
    # pattern, and rightly so.
