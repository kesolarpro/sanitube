###############################################################################
# SaniTube
#
# Nothing in the codebase hard-codes a domain, a provider or a path: every
# environment-specific value lives here. The defaults below are the portable
# ones — they work on a shared cPanel account with no Redis, no Docker and no
# object storage, and are upgraded by changing values, never code.
###############################################################################

APP_NAME=SaniTube

# SYS-001. Which release this installation is running, as whatever put the
# code on the server recorded it — a release tarball's packaging step, a
# deploy script, sanitube:update.
#
# No default, and blank rather than a guess. A version this platform invented
# would be worse than none: the question the system screen answers is "am I on
# the release that fixed the thing", and a constant answers yes for ever. An
# installation that records nothing is honestly unversioned, and both the
# system screen and every backup manifest say so.
#
# On a git checkout the commit is read from .git and answers the same question
# more precisely, so this is for deployments that carry no history.
SANITUBE_VERSION=

APP_ENV=local
APP_KEY=
APP_DEBUG=true

# The one place the installation's domain is defined. Any host works:
# https://music.example.com, https://catalogue.example.ca, http://localhost.
APP_URL=http://localhost

# Interface language. Track, release and lyrics languages are catalogue data
# and have nothing to do with this setting.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database — MySQL / MariaDB in production
#
# Use DB_CONNECTION=mariadb on cPanel and anywhere else running MariaDB: it is
# a distinct connection in Laravel and emits MariaDB-correct DDL rather than
# MySQL DDL that merely happens to parse. Both are covered by CI, alongside
# SQLite, which is what local work and the test suite use.
#
# No PostgreSQL-specific feature is used anywhere, so the schema stays portable.
###############################################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sanitube
DB_USERNAME=sanitube
DB_PASSWORD=

###############################################################################
# Session, cache and queue
#
# Database-backed by default: portable everywhere, no Redis required. On a VPS
# with Redis available, set these to "redis" — the application code is
# identical either way.
###############################################################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null unless you serve SaniTube across subdomains.
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Optional. Nothing requires Redis; it is an optimisation.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Mail
###############################################################################

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# SaniTube — storage
#
# "local" keeps masters on this server's disk: correct for development and for
# small single-server installs, but it cannot issue expiring URLs.
#
# S3-compatible object storage is the recommended production target and
# requires one extra package:
#
#   composer require league/flysystem-aws-s3-v3
#
# Supported values: local, s3, r2, b2
###############################################################################

SANITUBE_STORAGE_PROVIDER=local

# On shared hosting, point this OUTSIDE public_html. A master reachable over
# HTTP is a master that leaks; this is the single most important line here.
# SANITUBE_LOCAL_STORAGE_ROOT=/home/user/sanitube-storage

# How long a signed URL handed to a browser or a distributor stays valid.
# There is no permanent-URL path for a master, by design.
SANITUBE_TEMPORARY_URL_TTL=900

# Amazon S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=

# Backblaze B2 (S3-compatible endpoint)
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_DEFAULT_REGION=
B2_BUCKET=
B2_ENDPOINT=

###############################################################################
# SaniTube — assets
#
# Upload limits per kind, in bytes. Enforced while the bytes are still
# streaming, so an oversized upload is cut off rather than stored and then
# judged.
#
# PHP's own upload_max_filesize and post_max_size still cap browser uploads and
# are usually the lower of the two on shared hosting: raising a value here does
# not raise those. Check the account's disk quota too — the default allows a
# 2 GB master.
###############################################################################

# SANITUBE_MAX_MASTER_BYTES=2147483648
# SANITUBE_MAX_ARTWORK_BYTES=67108864
# SANITUBE_MAX_DOCUMENT_BYTES=8388608

# How long an unfinished upload is left in staging before the nightly cleanup
# removes it. Generous on purpose: a slow upload of a large master on a poor
# connection is not an abandoned one.
SANITUBE_STAGING_TTL_HOURS=24

# Identical bytes are recorded as a duplicate, never rejected. Both objects are
# kept; see docs/adr/ADR-0012.
SANITUBE_DETECT_DUPLICATES=true

# How many assets one verification pass re-reads from storage. Bounded so the
# command finishes inside a shared host's cron window.
SANITUBE_VERIFY_BATCH=100

###############################################################################
# SaniTube — media processing
#
# FFmpeg is optional. Without it the catalogue works and assets are still
# registered; audio analysis and derivative generation report as unavailable.
# On shared hosting, point this at an uploaded static build.
###############################################################################

SANITUBE_FFMPEG_PATH=ffmpeg
SANITUBE_FFPROBE_PATH=ffprobe
SANITUBE_FFPROBE_TIMEOUT=120

# Leave false unless this host is guaranteed to have FFmpeg. When false, an
# imported candidate becomes READY with its analysis columns null — honest
# about what was measured. When true, a host that cannot probe leaves every
# candidate in WAITING_CAPABILITY and nothing can be promoted until FFmpeg is
# installed and `php artisan sanitube:media:analyze` has run.
#
# Either way, an analyser that *runs* and rejects a file still says so.
SANITUBE_MEDIA_ANALYSIS_REQUIRED=false

###############################################################################
# SaniTube — AI providers
#
# Entirely optional. With no key configured — the state of every fresh install
# — AI features report themselves unavailable and everything else works
# identically. Nothing in SaniTube requires a model to catalogue, import,
# analyse or release a recording.
#
# The endpoints are here rather than in code so that an install behind a
# gateway, or one pointed at a self-hosted OpenAI-compatible service, changes a
# value instead of a file. A provider with no key or no endpoint is skipped.
#
# Supported values for the provider: none, openai, claude
#
# "none" rather than "null": Laravel reads the literal string `null` in a .env
# file as PHP null, so `SANITUBE_AI_PROVIDER=null` means "no value" rather than
# "the provider named null". Leaving this blank is also fine and means the same
# thing.
###############################################################################

SANITUBE_AI_PROVIDER=none

SANITUBE_OPENAI_BASE_URL=https://api.openai.com/v1
SANITUBE_OPENAI_KEY=
SANITUBE_OPENAI_MODEL=gpt-4o-mini

SANITUBE_CLAUDE_BASE_URL=https://api.anthropic.com/v1
SANITUBE_CLAUDE_KEY=
SANITUBE_CLAUDE_MODEL=claude-sonnet-4-5
SANITUBE_CLAUDE_VERSION=2023-06-01

# One call's ceiling. Short on purpose: an optional feature must not hold a
# queue worker that has real work waiting.
SANITUBE_AI_TIMEOUT=30
SANITUBE_AI_MAX_OUTPUT_TOKENS=1024

# Every call is recorded — provider, model, purpose, prompt version, tokens,
# duration, outcome — so a bad prompt can be traced to the records it touched
# and a token bill can be checked. The prompt and completion *text* are not
# stored unless you turn this on to debug a prompt. Turn it back off: it is
# where catalogue data would otherwise accumulate.
SANITUBE_AI_LEDGER_STORE_TEXT=false

# How many AI calls this installation is willing to make in a rolling window.
# Operational safety, not accounting: these count calls, not money. 0 means no
# ceiling. Set them once you know what a suggestion is worth to you -- the
# backlog ceiling bounds how much work is QUEUED and bounds nothing about how
# much of it reaches a vendor over the following week.
SANITUBE_AI_DAILY_CALLS=0
SANITUBE_AI_WEEKLY_CALLS=0
SANITUBE_AI_MONTHLY_CALLS=0

# Stop asking a provider that has stopped answering. A vendor outage answers
# every request identically and immediately, and a worker holding two thousand
# jobs will discover that two thousand times. Reopens by itself. 0 disables it.
SANITUBE_AI_CIRCUIT_FAILURES=5
SANITUBE_AI_CIRCUIT_COOLDOWN_MINUTES=15

###############################################################################
# SaniTube — transcription
#
# Speech to text, used to enrich a catalogue and never to decide anything in
# it. "none" is the default and a legitimate permanent choice: an installation
# with no supplier ingests, deduplicates, organises and distributes exactly as
# it would otherwise, and simply has no transcripts.
#
# Supported values: none, openai
#
# The OpenAI credentials fall back to SANITUBE_OPENAI_* above, because they are
# the same account. Set these only when transcription should bill a different
# key -- a separate project, a separate budget.
###############################################################################

SANITUBE_TRANSCRIPTION_PROVIDER=none

# Off, and deliberately. Turning this on transcribes every audio asset as it
# arrives -- one paid supplier call each, with no local ceiling that would stop
# a four-thousand-file library spending four thousand of them. Leave it off and
# use `php artisan sanitube:transcription:backlog --limit=…` for a sweep you
# can size.
SANITUBE_TRANSCRIPTION_AUTOMATIC=false

SANITUBE_TRANSCRIPTION_OPENAI_BASE_URL=
SANITUBE_TRANSCRIPTION_OPENAI_KEY=

# whisper-1 is the model whose timed-segment response the official API
# specification pins. The newer transcription models can be named here.
SANITUBE_TRANSCRIPTION_OPENAI_MODEL=whisper-1

# One transcription's ceiling, in seconds. Longer than the AI timeout on
# purpose: this call is bounded by how long the audio is.
SANITUBE_TRANSCRIPTION_TIMEOUT=300

# Local policy, not an API limit: what this installation is willing to pay to
# upload. 0 removes the ceiling and leaves the supplier's own refusal as the
# only authority.
SANITUBE_TRANSCRIPTION_MAX_BYTES=26214400

###############################################################################
# SaniTube — AI enrichment
#
# Turning a transcript into suggested title, language, genres, moods, themes
# and description. Every one of those is a SUGGESTION: it waits for a person
# and never becomes catalogue data on its own.
#
# Off, and more emphatically than automatic transcription. This is the SECOND
# paid call on the same asset -- the first was the transcription that produced
# the evidence it reads -- so switching both on together doubles a bill before
# you have seen a single result.
###############################################################################

SANITUBE_ENRICHMENT_AUTOMATIC=false

# How much of a transcript is sent. A per-token bill, and a payload ceiling on
# text that arrived from outside this installation.
SANITUBE_ENRICHMENT_MAX_EVIDENCE_CHARACTERS=8000

###############################################################################
# SaniTube — music generation
#
# Optional, and unavailable by default: no music generation API is wired to
# this platform yet. Everything else — import, analysis, catalogue, releases —
# works without one.
#
# Supported values: none, fake, acestep
#
# "fake" is shipped rather than test-only. It runs the whole Studio workflow
# without a network so the feature can be demonstrated and reviewed on an
# installation with no provider account. It produces silence, not music.
#
# "acestep" is self-hosted ACE-Step, and it needs no credentials of its own:
# it is reached through a generation worker, so what configures it is
# SANITUBE_WORKER_URL and SANITUBE_WORKER_TOKEN. Selecting it without a worker
# leaves the Studio reporting the provider as unavailable, which is what it is.
#
# "none", never "null" — Laravel reads the literal string null in a .env file
# as PHP null, which means "no value" rather than "the provider named null".
###############################################################################

SANITUBE_GENERATION_PROVIDER=none

# Generation is asynchronous and there is no webhook endpoint yet, so progress
# is discovered by polling. Both bounds exist so that a provider which never
# answers costs a fixed amount of work: past max_polls the generation is failed
# rather than left in flight for ever.
SANITUBE_GENERATION_MAX_POLLS=60
SANITUBE_GENERATION_POLL_INTERVAL=30

# What a supplier is allowed to cost before the platform stops asking.
#
# Rolling windows, not calendar ones: "the last 24 hours" needs no time zone
# and cannot be gamed by starting a sweep at 23:55. Zero means no ceiling and
# is the shipped default — a platform whose first experience of generation is a
# refusal is one nobody turns on twice. Set these once you know what a track is
# worth to make.
#
# The failure they prevent is specific: a backfill over four thousand masters
# enqueues four thousand jobs, and a queue that drains steadily spends steadily.
# The first sign of that is an invoice.
SANITUBE_GENERATION_DAILY_LIMIT=0
SANITUBE_GENERATION_WEEKLY_LIMIT=0
SANITUBE_GENERATION_MONTHLY_LIMIT=0

# A supplier having an outage answers every request identically and
# immediately, so a worker holding two thousand jobs burns through them — and
# through whatever each failed call is billed at. After this many consecutive
# failures the platform stops asking for this long.
SANITUBE_GENERATION_CIRCUIT_FAILURES=5
SANITUBE_GENERATION_CIRCUIT_COOLDOWN=15

###############################################################################
# SaniTube — self-hosted ACE-Step
#
# Only read on a GPU worker host, and only when SANITUBE_GENERATION_PROVIDER is
# `acestep`. Core never talks to the engine: ACE-Step answers with a path on its
# own filesystem, and requiring Core to open that path would mean requiring a
# shared filesystem between a shared hosting account and a GPU box. The worker
# opens the file and stages the bytes into the storage both sides share.
#
# `endpoint` and `output_root` are the two that must be set for the engine to
# run at all. `output_root` is the *only* directory the worker will open a file
# from — absolute, on the worker host, and it must exist; an unresolvable root
# refuses every generation rather than widening.
###############################################################################

SANITUBE_ACESTEP_ENDPOINT=
SANITUBE_ACESTEP_OUTPUT_ROOT=
SANITUBE_ACESTEP_CHECKPOINT_PATH=
SANITUBE_ACESTEP_DEVICE_ID=0
SANITUBE_ACESTEP_TIMEOUT=900
SANITUBE_ACESTEP_HEALTH_TIMEOUT=5

# Rendering parameters, all of them the operator's. None is reachable from a
# generation request: one that could set infer_step would be one that decides
# what a generation costs to run.
SANITUBE_ACESTEP_DURATION=60
SANITUBE_ACESTEP_INFER_STEP=60
SANITUBE_ACESTEP_GUIDANCE=15

###############################################################################
# SaniTube — artwork
#
# What a cover has to be, and who is paid to make one.
#
# The requirements are SETTINGS, NOT FACTS. Every store publishes its own
# specification and they disagree at the edges; the defaults are the
# intersection that is commonly required. No distributor is named here or in
# the code that reads these. An operator delivering somewhere with different
# rules changes a number rather than patching a validator.
#
# 0 means "no requirement" for a threshold and "no ceiling" for a limit, and
# it is honoured everywhere. A rule nobody wants is switched off rather than
# worked around.
#
# Supported providers: none, openai
#
# READ THIS BEFORE TURNING GENERATION ON. The one square size the image
# provider is asked for by default is 1024x1024, which is SMALLER than
# SANITUBE_ARTWORK_MINIMUM_PIXELS below. The platform refuses with
# REQUIREMENTS_UNREACHABLE rather than spending on covers its own validator
# then rejects. Resolve it by lowering the requirement, or by declaring a
# larger size your account and model actually support in config/artwork.php.
#
# The OpenAI credentials fall back to SANITUBE_OPENAI_* above, because they
# are the same account. Set these only when artwork should bill a different
# key.
###############################################################################

SANITUBE_ARTWORK_PROVIDER=none

# A dedicated off switch, separate from the global background-work pause.
# Both stop generation and they answer different questions: the pause means
# "this installation is doing nothing right now", this means "this
# installation does not generate covers".
SANITUBE_ARTWORK_GENERATION_ENABLED=true

SANITUBE_ARTWORK_OPENAI_BASE_URL=
SANITUBE_ARTWORK_OPENAI_KEY=
SANITUBE_ARTWORK_OPENAI_MODEL=gpt-image-1

# png, jpeg or webp. Note that webp is not accepted by default, so choosing it
# without also accepting it produces covers this platform then rejects.
SANITUBE_ARTWORK_OPENAI_FORMAT=png

SANITUBE_ARTWORK_TIMEOUT=120

# The shorter side, not the width: a 4000x1000 image satisfies "at least 3000
# wide" and is not usable as a cover.
SANITUBE_ARTWORK_MINIMUM_PIXELS=3000

# Some stores reject very large files outright, and a 20000px cover is nearly
# always a mistake. 0 disables it.
SANITUBE_ARTWORK_MAXIMUM_PIXELS=0

# Bytes. 0 disables the check.
SANITUBE_ARTWORK_MAXIMUM_BYTES=0

SANITUBE_ARTWORK_REQUIRE_SQUARE=true

# Only formats that record a channel count can be judged -- JPEG does, PNG does
# not. When nothing was measured the answer is "unknown", and an unknown is
# never reported as a pass.
SANITUBE_ARTWORK_REFUSE_CMYK=true

# How many cover generations this installation is willing to ask for inside a
# rolling window. Requests, not money: there is no price, no currency and no
# balance anywhere near these. 0 means no ceiling.
SANITUBE_ARTWORK_DAILY_LIMIT=0
SANITUBE_ARTWORK_WEEKLY_LIMIT=0
SANITUBE_ARTWORK_MONTHLY_LIMIT=0

# Stop asking a provider that has stopped answering. Consecutive failures, not
# a failure rate. 0 disables the breaker entirely, which is a legitimate
# setting for an operator who would rather see every failure.
SANITUBE_ARTWORK_CIRCUIT_FAILURES=5
SANITUBE_ARTWORK_CIRCUIT_COOLDOWN=15

# How long one worker's claim on a generation request lasts before another may
# take it. Long enough that a slow provider call is not overtaken; short enough
# that a worker killed mid-flight does not park a request for ever.
SANITUBE_ARTWORK_CLAIM_SECONDS=900

###############################################################################
# SaniTube — distribution
#
# No distributor account is wired to this platform yet. Too Lost is the first
# intended adapter and arrives in DIST-002; the catalogue, the Studio and the
# release builder all work without one. A distributor is an outbound channel,
# never the centre.
#
# Supported values: none, fake
#
# "fake" is shipped rather than test-only: it runs the whole delivery engine —
# validate, prepare, submit, poll, take down — with no account and no network.
#
# "none", never "null", for the reason the AI and generation providers use it.
###############################################################################

SANITUBE_DISTRIBUTOR=none

###############################################################################
# SaniTube — API and health
#
# Three distinct levels:
#   /up and /api/v1/health/live   public liveness. Answers from the process
#                                 alone — no database, no cache, no storage,
#                                 no capability detectors.
#   /api/v1/health/ready          readiness. Token + throttle.
#   /api/v1/system/capabilities   full environment report. Token + throttle.
#
# The last two describe the environment, so they return 404 until a token is
# set. Generate one with:
#   php artisan tinker --execute="echo bin2hex(random_bytes(32));"
###############################################################################

SANITUBE_API_PREFIX=api
SANITUBE_API_RATE_LIMIT=60
SANITUBE_HEALTH_TOKEN=

# Liveness is throttled through its own cache store so that a database outage
# cannot stop it answering. Leave this as "file" unless you know why not.
SANITUBE_HEALTH_THROTTLE_STORE=file
SANITUBE_HEALTH_LIVE_RATE_LIMIT=120
SANITUBE_HEALTH_PRIVILEGED_RATE_LIMIT=30

# auto | shared | vps — only used to explain missing capabilities.
SANITUBE_RUNTIME_PROFILE=auto

VITE_APP_NAME="${APP_NAME}"
